<!DOCTYPE html>
<html>

<head>
    <title>Shopping Cart</title>

    <style>
        body {
            font-family: Arial;
            background: #eee;
            text-align: center;
            padding: 40px;
        }

        .container {
            background: white;
            width: 600px;
            margin: auto;
            padding: 25px;
            border-radius: 10px;
        }

        input {
            padding: 10px;
            margin: 5px;
            width: 120px;
        }

        button {
            padding: 10px 15px;
            margin: 5px;
            cursor: pointer;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
        }

        th {
            background: #ddd;
        }

        .result {
            margin-top: 20px;
            text-align: left;
            background: #f5f5f5;
            padding: 15px;
        }

        .final {
            font-size: 20px;
            font-weight: bold;
        }
    </style>

</head>

<body>

<div class="container">

    <h2>🛒 Shopping Cart</h2>

    <!-- Input Section -->

    <input type="text" id="name" placeholder="Product Name">

    <input type="number" id="price" placeholder="Price">

    <input type="number" id="quantity" placeholder="Quantity">

    <br>

    <button onclick="addProduct()">Add Product</button>

    <button onclick="clearCart()">Clear Cart</button>


    <!-- Product Table -->

    <table>

        <thead>

            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Amount</th>
            </tr>

        </thead>

        <tbody id="cartTable">
        </tbody>

    </table>


    <!-- Result -->

    <div class="result">

        <p>
            <b>Total Amount:</b>
            ₹<span id="total">0</span>
        </p>

        <p>
            <b>Discount:</b>
            ₹<span id="discount">0</span>
        </p>

        <p class="final">
            Final Amount to be Paid:
            ₹<span id="finalAmount">0</span>
        </p>

    </div>

</div>


<script>

// Empty shopping cart
let cart = [];


// Add Product
function addProduct() {

    // Get input values
    let name = document.getElementById("name").value.trim();

    let price = Number(document.getElementById("price").value);

    let quantity = Number(document.getElementById("quantity").value);


    // Check input
    if (name === "" || price <= 0 || quantity <= 0) {

        alert("Please enter valid product details");

        return;

    }


    // Create product object
    let product = {
        name: name,
        price: price,
        quantity: quantity
    };


    // Add object to array
    cart.push(product);


    // Clear input fields
    document.getElementById("name").value = "";
    document.getElementById("price").value = "";
    document.getElementById("quantity").value = "";


    // Display cart
    displayCart();

}


// Display Cart
function displayCart() {

    let table = document.getElementById("cartTable");

    table.innerHTML = "";


    // Display each product
    cart.forEach(function(item) {

        let amount = item.price * item.quantity;

        let row = `
            <tr>
                <td>${item.name}</td>
                <td>₹${item.price}</td>
                <td>${item.quantity}</td>
                <td>₹${amount}</td>
            </tr>
        `;

        table.innerHTML += row;

    });


    // Calculate total
    let total = cart.reduce(function(sum, item) {

        return sum + (item.price * item.quantity);

    }, 0);


    // Calculate discount
    let discount = 0;

    if (total > 1000) {

        discount = total * 0.10;

    }
    else if (total > 500) {

        discount = total * 0.05;

    }
    else if (total > 200) {

        discount = total * 0.02;

    }


    // Calculate final amount
    let finalAmount = total - discount;


    // Display results
    document.getElementById("total").innerText =
        total.toFixed(2);

    document.getElementById("discount").innerText =
        discount.toFixed(2);

    document.getElementById("finalAmount").innerText =
        finalAmount.toFixed(2);


    // Console output
    console.log("Total Amount:", total);

    console.log("Discount:", discount);

    console.log("Final Amount:", finalAmount);

}


// Clear Cart
function clearCart() {

    cart = [];

    displayCart();

}

</script>

</body>

</html>
